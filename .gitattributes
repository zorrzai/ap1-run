# The sealed standard text is byte-significant: its SHA-256 must match
# the Zenodo deposit exactly. Git must never convert line endings in it.
reference/** -text

# Hygiene for everything else -- LF on all platforms.
*.md   text eol=lf
# Branch september-seal: .py files are stored byte-for-byte as they were on
# disk when the September runs were sealed (mixed CRLF/LF), so that a checkout
# reproduces runner_source_hash exactly. Do not normalise them.
*.py   -text
*.json text eol=lf
*.yml  text eol=lf
